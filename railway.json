{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && python manage.py migrate && python manage.py collectstatic --noinput"
    },
    "deploy": {
        "startCommand": "gunicorn unidental.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 4 --worker-class gthread --worker-connections 1000 --max-requests 1000 --max-requests-jitter 100 --timeout 120 --keep-alive 5 --preload",
        "healthcheckPath": "/api/health/",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    },
    "environments": {
        "production": {
            "variables": {
                "DJANGO_SETTINGS_MODULE": "unidental.settings",
                "PYTHONPATH": ".",
                "PYTHONUNBUFFERED": "1",
                "DEBUG": "False",
                "USE_SQLITE_FOR_TESTS": "False",
                "ALLOWED_HOSTS": "127.0.0.1,localhost,.railway.app,.up.railway.app"
            }
        }
    }
}
